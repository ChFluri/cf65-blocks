{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cf65/icon-list-item",
	"version": "0.1.0",
	"title": "Icon-Listeneintrag (cf65)",
	"category": "cf65-blocks",
	"parent": [ "cf65/icon-list" ],
	"icon": "minus",
	"description": "Eintrag einer Icon-Liste, optional mit eigenem Icon.",
	"textdomain": "cf65-blocks",
	"usesContext": [ "cf65/iconListIcon", "postId", "postType" ],
	"attributes": {
		"markupVersion": { "type": "number", "default": 1 },
		"content": { "type": "string", "default": "" },
		"icon": { "type": "string" }
	},
	"supports": {
		"html": false,
		"className": true,
		"reusable": false,
		"splitting": true,
		"cf65": {
			"inlineDynamic": true,
			"styles": []
		}
	},
	"editorScript": "file:./index.js"
}
