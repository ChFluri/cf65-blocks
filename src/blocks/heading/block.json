{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cf65/heading",
	"version": "0.1.0",
	"title": "Überschrift (cf65)",
	"category": "cf65-blocks",
	"icon": "heading",
	"description": "Überschrift mit responsiver Schriftgrösse, Ausrichtung und Farben inkl. Hover.",
	"keywords": [ "heading", "titel", "überschrift" ],
	"textdomain": "cf65-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"uniqueId": { "type": "string" },
		"markupVersion": { "type": "number", "default": 1 },
		"content": { "type": "string", "default": "" },
		"level": { "type": "number", "default": 2 },
		"textAlign": { "type": "object" },
		"fontSize": { "type": "object" },
		"textColor": { "type": "string" },
		"textColorHover": { "type": "string" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"cf65": {
			"inlineDynamic": true,
			"styles": [
				{
					"attr": "textAlign",
					"property": "text-align",
					"type": "enum",
					"values": [ "left", "center", "right", "justify" ],
					"responsive": true
				},
				{
					"attr": "fontSize",
					"property": "font-size",
					"type": "length",
					"responsive": true
				},
				{ "attr": "textColor", "property": "color", "type": "color" },
				{
					"attr": "textColorHover",
					"property": "color",
					"type": "color",
					"state": "hover"
				}
			]
		}
	},
	"example": {
		"attributes": { "content": "Überschrift", "level": 2 }
	},
	"editorScript": "file:./index.js"
}
